{
  "protected_paths": [
    "CLAUDE.md",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/guard.json",
    ".claude/hooks/**",
    ".claude/agents/**",
    ".claude/skills/invariants/SKILL.md",
    ".claude/skills/gate/SKILL.md",
    ".claude/skills/regress/SKILL.md",
    ".claude/skills/rule-change/SKILL.md",
    ".claude/workflow-docs/**",
    ".claude/context/acceptance.md"
  ],
  "real_data_paths": [
    "data/real/**"
  ],
  "approvals_dir": ".claude/context/approvals/",
  "rule_changes_file": ".claude/context/rule-changes.md",
  "blocked_hosts": [
    "<<FILL: production hostnames, one entry per host>>"
  ],
  "blocked_command_patterns": [
    "git\\s+push\\b.*(--force|--force-with-lease|\\s-f\\b)",
    "git\\s+reset\\s+--hard",
    "rm\\s+-\\S*\\s+(/|~/?|\\./?|\\.\\./?|\\*)(\\s|$)",
    "\\b(npm|yarn|pnpm)\\s+publish\\b",
    "\\btwine\\s+upload\\b"
  ],
  "secret_command_patterns": [
    "(^|[\\s/'\"=<>])[\\w.*-]*\\.env(\\.[\\w-]+)?($|[\\s'\";|&)])",
    "\\.(pem|key)($|[\\s'\";|&)])",
    "(^|[;&|]\\s*|\\s)printenv(\\s|$)",
    "(^|[;&|]\\s*)(env|set)\\s*($|[;&|])",
    "\\b(export\\s+-p|declare\\s+-[a-z]*[xp])\\b",
    "/proc/[\\w/]*/environ",
    "os\\.environ|process\\.env|getenv\\(",
    "\\$\\{?\\w*(key|token|secret|password|passwd|auth)\\w*",
    "\\.(ssh|aws)/|\\.netrc|\\.pgpass|\\.npmrc|\\.pypirc|\\.git-credentials",
    "\\bid_(rsa|dsa|ecdsa|ed25519)\\b"
  ]
}
